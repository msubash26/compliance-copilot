# Copy to .env and fill in. .env is gitignored; this file is committed.
#   cp .env.example .env
# Generate every secret below with:  openssl rand -hex 32

# ── Host port map (see ADR-003, ADR-007) ─────────────────────────────────────
# 5432 = host PostgreSQL 16   |  6379 = host redis-server. Both are taken, so:
#   5434 -> LangFuse's Postgres      (LangFuse-owned, inspect-only)
#   6380 -> LangFuse's Redis
#   5433 -> LangGraph checkpointer   (ours)
#   3000 -> LangFuse UI  |  9090 -> MinIO  |  8123/9000 -> ClickHouse

# ── LangFuse container secrets (consumed by docker/docker-compose.yml) ───────
# CHANGEME — upstream ships weak defaults for all of these.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Upstream defaults this to true. Off: the air-gapped claim (ADR-005) has to be
# true of the observability plane too, not just the inference path.
TELEMETRY_ENABLED=false

# ── Derived values that MUST match the passwords above ───────────────────────
# Upstream embeds credentials in these defaults instead of composing them from
# the *_PASSWORD vars, so setting a password alone is NOT enough — the service
# comes up with the new password while LangFuse keeps using the old default and
# fails to authenticate. Hostnames/ports here are compose-network internal
# (`postgres:5432`, `minio:9000`) — NOT the remapped host ports.
# URL-encode the password if you use anything outside [A-Za-z0-9._~-].
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/postgres
MINIO_ROOT_USER=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>

# ── LangFuse bootstrap ───────────────────────────────────────────────────────
# Setting these seeds the org, project, user and API keys on first boot, so B3
# needs no click-through and the keys below are known before the stack starts.
LANGFUSE_INIT_ORG_ID=regops
LANGFUSE_INIT_ORG_NAME=regops
LANGFUSE_INIT_PROJECT_ID=compliance-copilot
LANGFUSE_INIT_PROJECT_NAME=compliance-copilot
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-
LANGFUSE_INIT_USER_EMAIL=msubash26@gmail.com
LANGFUSE_INIT_USER_NAME=Subash M
LANGFUSE_INIT_USER_PASSWORD=

# ── LangFuse SDK (consumed by Python; must match the INIT_PROJECT keys) ──────
LANGFUSE_PUBLIC_KEY=pk-lf-
LANGFUSE_SECRET_KEY=sk-lf-
LANGFUSE_HOST=http://localhost:3000

# ── LangGraph checkpointer (ours — separate container, ADR-004) ──────────────
CHECKPOINTER_POSTGRES_USER=regops
CHECKPOINTER_POSTGRES_PASSWORD=
CHECKPOINTER_POSTGRES_DB=checkpointer
CHECKPOINTER_DSN=postgresql://regops:CHANGEME@localhost:5433/checkpointer

# ── Local inference (ADR-005) ────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_SMALL_MODEL=qwen3.5:9b
OLLAMA_LARGE_MODEL=qwen3.8:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
