.venv/
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
# `corpus/` alone would win: git cannot re-include a file whose parent directory is
# excluded, so the negation below would never fire. Exclude the *contents* instead.
corpus/*
!corpus/manifest.jsonl
outputs/
.tmp/
*.log
*.duckdb
*.duckdb.wal
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
